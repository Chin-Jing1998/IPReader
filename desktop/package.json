{
  "name": "patentreader-desktop",
  "private": true,
  "version": "1.1.0",
  "description": "PatentReader · 专利知识库桌面端——quartz 静态站 + Electron 本地 http 托管（默认离线）",
  "author": "张京京",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "smoke": "electron smoke.cjs",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.patentreader.app",
    "productName": "PatentReader",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "server.cjs",
      "updater.cjs",
      "!**/.DS_Store"
    ],
    "extraResources": [
      {
        "from": "../quartz-kb/public",
        "to": "kb-public",
        "filter": [
          "**/*",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "../mcp/dist",
        "to": "mcp",
        "filter": [
          "**/*",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icons/icon-light.png",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon-dark.png",
        "to": "icons/icon-dark.png",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "darkModeSupport": true,
      "icon": "build/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PatentReader",
      "uninstallDisplayName": "PatentReader",
      "artifactName": "PatentReader-Setup-${version}.${ext}"
    }
  }
}
